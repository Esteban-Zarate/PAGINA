# Copia este archivo como secrets.toml y completa tus propios datos.
# NO publiques secrets.toml en GitHub.

[smtp]
host = "smtp.gmail.com"
port = 587
user = "tu-correo@ejemplo.com"
password = "TU_APP_PASSWORD"
from = "tu-correo@ejemplo.com"
use_tls = true

# IA opcional:
# Puedes definir OPENAI_API_KEY como variable de entorno.


# IA de EcoBot Solar: una sola configuración para todos los usuarios y administradores.
[ai]
api_key = "TU_CLAVE_DE_OPENAI"
model = "gpt-5-mini"
